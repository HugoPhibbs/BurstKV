FROM golang:1.27-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \ 
    go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /db_pod ./cmd/db_pod

FROM alpine:3.22
RUN apk add --no-cache redis
COPY --from=build /db_pod /usr/local/bin/db_pod
ENTRYPOINT ["db_pod"]