{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "protoc: generate (pod)",
            "type": "shell",
            "command": "protoc --go_out=. --go_opt=module=burstkv --go-grpc_out=. --go-grpc_opt=module=burstkv proto/db_pod.proto",
            "problemMatcher": []
        },
        {
            "label": "protoc: generate (controller)",
            "type": "shell",
            "command": "protoc --go_out=. --go_opt=module=burstkv --go-grpc_out=. --go-grpc_opt=module=burstkv proto/controller.proto",
            "problemMatcher": []
        },
        {
            "label": "act: PR",
            "type": "shell",
            "command": "act pull_request",
            "problemMatcher": []
        },
        {
            "label": "start: dev snapshot server",
            "type": "shell",
            "command": "python scripts/start_dev_snapshot_server.py",
            "problemMatcher": []
        },
        {
            "label": "tests (all)",
            "type": "shell",
            "command": "go test ./... -v",
            "problemMatcher": []
        },
        {
            "label": "Build db image",
            "type": "shell",
            "command": "docker build -f docker/Dockerfile.db_pod -t burstkv-dbpod:${input:imageVersion} .",
            "problemMatcher": []
        },
        {
            "label": "start dev cluster",
            "type": "shell",
            "command": "chmod +x ./scripts/dev_start.sh && ./scripts/dev_start.sh",
            "problemMatcher": []
        },
        {
            "label": "controller logs",
            "type": "shell",
            "command": "kubectl logs -f deploy/burstkv-controller",
            "problemMatcher": []
        },   
        {
            "label": "build cli",
            "type": "shell",
            "command": "go install ./cmd/bkv",
            "problemMatcher": []
        }, 
        {
            "label": "go tidy",
            "type": "shell",
            "command": "go mod tidy", 
            "problemMatcher": "$go"
        }
    ],
    "inputs": [
        {
            "id": "imageVersion",
            "type": "promptString",
            "description": "Image version",
            "default": "latest"
        },
        {
            "id": "controllerAddr",
            "type": "promptString",
            "description": "Controller server address",
            "default": "http://localhost:6378"
        }
    ]
}