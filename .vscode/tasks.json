{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: build-worker",
            "type": "shell",
            "command": "go build -o bin/worker.exe ./cmd/worker",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "go: run-worker",
            "type": "shell",
            "command": "./bin/worker.exe",
            "dependsOn": ["protoc: generate", "go: build-worker"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "protoc: generate",
            "type": "shell",
            "command": "protoc --go_out=. --go_opt=module=burstkv --go-grpc_out=. --go-grpc_opt=module=burstkv proto/db_pod.proto",
            "problemMatcher": []
        },
        {
            "label": "act: PR",
            "type": "shell",
            "command": "act pull_request",
            "problemMatcher": []
        },
        {
            "label": "start: dev snapshot server",
            "type": "shell",
            "command": "python scripts/start_dev_snapshot_server.py",
            "problemMatcher": []
        }, 
        {
            "label": "tests (all)", 
            "type": "shell",
            "command": "go test ./... -v",
            "problemMatcher": []
        },
        {
            "label": "Build db image",
            "type": "shell", 
            "command": "docker build -f docker/Dockerfile.db_pod -t ${input:imageTag} .",
            "problemMatcher": []
        },
    ],
    "inputs": [
        {
            "id": "imageTag",
            "type": "promptString",
            "description": "Image tag",
            "default": "latest"
        }
    ]
}
